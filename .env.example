# ==============================================================================
# Environment variables for the Doc Verification Agent Backend
# Copy this file to .env in the same directory and fill in your values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# API key for Groq Cloud (used for OCR fallback with Llama 3.3)
# Get one from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL connection string for database storage
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:1136@localhost:5432/doc_verification

# CORS Allowed Origins
# A comma-separated list of origins permitted to request resources from this API.
# Note: Do not include trailing slashes (e.g. http://localhost:5173).
# Include your frontend production domain here.
ALLOWED_ORIGINS=https://doc-verification-agent.auremoai.site

# Server settings for running via 'python main.py'
HOST=0.0.0.0
PORT=8039

# Optional: Path to the Tesseract OCR executable.
# - On Windows, this points to your local tesseract.exe path.
# - On Linux (Ubuntu), leave this commented out or blank if 'tesseract' is installed in the system PATH.
# TESSERACT_CMD=/usr/bin/tesseract
